# Copy this file to .env and adjust as needed. .env is gitignored -- never
# commit real secrets. These are dummy local-dev values matching spec.md 6.3a.

DEVPILOT_MCP_TOKEN=local-dev-token
DEVPILOT_MCP_PORT=8080
DEVPILOT_JOURNAL_TABLE=devpilot-journal

# DynamoDB Local only -- leave unset to use real AWS
AWS_ENDPOINT_URL_DYNAMODB=http://127.0.0.1:8000
AWS_ACCESS_KEY_ID=dummy
AWS_SECRET_ACCESS_KEY=dummy
AWS_DEFAULT_REGION=ap-south-1

# Stage 2 -- watch tools (docker compose up)
# Comma-separated container names DevPilot is allowed to inspect.
DEVPILOT_WATCH_CONTAINERS=demo-app

# Controls demo-app's behavior -- see the FAILURE_MODE table in README.md.
# Starts broken by default so "why is demo-app down?" works immediately.
FAILURE_MODE=missing_env
